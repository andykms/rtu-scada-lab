{
  "name": "rtu-scada-lab",
  "version": "1.0.0",
  "description": "Программа конструктор SCADA/киберфизических систем",
  "main": "dist/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build --prefix src/rtu-scada-frontend",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build:electron && concurrently -k -s first \"npm run start --prefix src/rtu-scada-frontend\" \"wait-on http://localhost:4200 && cross-env ELECTRON_START_URL=http://localhost:4200 electron dist/electron/main.js\"",
    "electron:watch": "nodemon --watch src/electron --ext ts --exec \"npm run build:electron && npm run electron:dev\"",
    "electron:prod": "npm run build --prefix src/rtu-scada-frontend -- --configuration production --base-href ./ && npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "com.rtuscada.lab",
    "productName": "RTU SCADA Lab",
    "icon": "src/rtu-scada-frontend/public/rtu-lab-logo.png",
    "files": [
      "dist/electron/**/*",
      "dist/rtu-scada-frontend/browser/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "src/rtu-scada-frontend/public/rtu-lab-logo.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "src/rtu-scada-frontend/public/rtu-lab-logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/rtu-scada-frontend/public/rtu-lab-logo.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykms/rtu-scada-lab.git"
  },
  "keywords": [],
  "author": "andrey isaev",
  "contributors": [
    {
      "name": "andrey isaev",
      "email": "andyakmas@yandex.ru"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andykms/rtu-scada-lab/issues"
  },
  "homepage": "https://github.com/andykms/rtu-scada-lab#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "wait-on": "^8.0.1"
  }
}
